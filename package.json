{
  "name": "@cybozu/eslint-config",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "repository": "cybozu/eslint-config",
  "homepage": "https://github.com/cybozu/eslint-config",
  "bugs": "https://github.com/cybozu/eslint-config/issues",
  "version": "26.0.0",
  "description": "Oxlint configuration presets for Cybozu",
  "exports": {
    ".": "./presets/base.oxlintrc.json",
    "./presets/base": "./presets/base.oxlintrc.json",
    "./presets/es5": "./presets/es5.oxlintrc.json",
    "./presets/kintone-customize": "./presets/kintone-customize.oxlintrc.json",
    "./presets/kintone-customize-es5": "./presets/kintone-customize-es5.oxlintrc.json",
    "./presets/node": "./presets/node.oxlintrc.json",
    "./presets/react": "./presets/react.oxlintrc.json",
    "./presets/react-typescript": "./presets/react-typescript.oxlintrc.json",
    "./presets/typescript": "./presets/typescript.oxlintrc.json"
  },
  "files": [
    "presets"
  ],
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "inventory": "tsx scripts/rule-inventory.ts",
    "baseline:capture": "tsx scripts/diff-against-baseline.ts capture",
    "baseline:check": "tsx scripts/diff-against-baseline.ts check"
  },
  "keywords": [
    "oxlint",
    "oxlint-config",
    "oxfmt",
    "linter",
    "typescript",
    "cybozu"
  ],
  "author": "cybozu",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.5",
    "oxlint": "^1.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "oxlint": ">=1.0.0",
    "oxlint-tsgolint": ">=0.1.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "oxlint-tsgolint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.33.4",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
